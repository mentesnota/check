{
  "hosting": [
    {
      "target": "buildwise-con-estimator",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://ethio-con-tech.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://ethio-con-tech.web.app/:path",
          "type": 301
        }
      ]
    },
    {
      "target": "ethio-con-tech",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
